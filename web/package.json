{
  "name": "personalclaw-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PersonalClaw web app \u2014 the dashboard UI",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "audit:consistency": "PC_WRITE_AUDIT=1 vitest run src/design/consistencyAudit.generate.test.ts",
    "docs:feature-map": "PC_WRITE_FEATURE_MAP=1 vitest run src/app/featureMap.test.tsx",
    "design:detect": "node scripts/designDetector.mjs",
    "ui:ratchet": "vitest run src/design/primitiveAdoption.test.ts --outputFile.junit=../reports/junit-ui-quality.xml",
    "generate:schemes": "PC_WRITE_SCHEMES=1 vitest run src/design/schemeSheets.test.ts",
    "test:watch": "vitest",
    "e2e": "playwright test --grep-invert @visual && npm run e2e:ui && npm run e2e:visual",
    "e2e:visual": "node e2e/run-pinned.mjs -- e2e/visual.spec.ts",
    "e2e:ui": "playwright test e2e/surfaces.spec.ts e2e/surfaceMatrix.control.spec.ts && playwright test e2e/idleCost.spec.ts",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "e2e:update": "node e2e/run-pinned.mjs --update -- e2e/visual.spec.ts",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@antv/infographic": "^0.2.20",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "framer-motion": "^14.2.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
