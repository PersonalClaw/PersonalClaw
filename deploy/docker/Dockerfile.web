# Build context is the repo root:
#   docker build -f deploy/docker/Dockerfile.web .

# ── Stage 1: build SPA ───────────────────────────────────────────────────────
FROM mirror.gcr.io/library/node:20-alpine AS builder

WORKDIR /app

# npm-workspaces install: the ONLY lockfile lives at the repo root (web/ and
# desktop/ carry none — npm/cli#4828), so `npm ci` must run from the root with
# the target workspace's package.json present. The `desktop` workspace is NOT
# copied — it's excluded by .dockerignore and `--workspace=web` doesn't need it
# (verified: npm ci resolves web's tree from the root lock alone). Manifests
# first for layer caching.
COPY package.json package-lock.json ./
COPY web/package.json web/

# THE ROOT `postinstall` HOOK RUNS HERE AND ITS SCRIPT HAS TO BE PRESENT. `package.json`
# declares `postinstall: sh scripts/install_git_hooks.sh`, so `npm ci` invokes it — and
# `scripts/` was not copied, so npm died with `exit code 2` on a missing file and this image
# could not be built at all. The script is already WRITTEN for this case: its header names
# "Docker build context" among the not-a-dev-clone paths and it exits 0 at the
# `git rev-parse --is-inside-work-tree` guard (`.git` is dockerignored). It was never given
# the chance. Copying it is therefore the fix rather than `--ignore-scripts`, which would
# also suppress the dependency postinstalls the SPA build needs (esbuild's, notably).
#
# This broke AFTER the last release, which is why no green check ever showed it: `v0.1.3`
# carried only `hooks:install`, and `postinstall` arrived later in #1030 (194bf9988).
# `release.yml` is the ONLY workflow that builds this file, it has not run since that tag, and
# it uses the same `context: .`, so the next release would have failed here.
COPY scripts/install_git_hooks.sh scripts/

RUN npm ci --workspace=web --prefer-offline

# THE SPA TYPECHECKS AGAINST ONE FILE OUTSIDE `web/`. `web/src/lib/scanFindings.ts:1` does
# `import glossSource from '../../../src/personalclaw/scan_rule_gloss.json'`, which resolves
# to /app/src/personalclaw/… from WORKDIR /app — so without it `tsc --noEmit` fails TS2307
# and the `build` script never reaches vite.
#
# It is exactly ONE file, measured rather than assumed: it is the only non-test module under
# `web/src` whose specifier escapes `web/`, and tsc reports every TS2307 rather than the
# first, so the single error in the build log IS the complete count. The other out-of-tree
# references under `web/src` are runtime path STRINGS in `*.test.*` files, which typecheck
# without resolving. If another cross-tree import ever lands, it fails here the same way and
# belongs on this list.
#
# Same provenance as the COPY above: `scanFindings.ts` arrived after `v0.1.3` (4c03d73ae), and
# `release.yml` — this file's only builder — has not run since, so this too would have failed
# the next release rather than any PR.
COPY src/personalclaw/scan_rule_gloss.json src/personalclaw/

# Copy full web source and build
COPY web/ web/

# tsc + vite on this SPA need more than node's default (~2 GiB) old-space heap;
# without this the in-container build dies with "JavaScript heap out of memory"
# even when the container itself has plenty of RAM.
RUN NODE_OPTIONS=--max-old-space-size=4096 npm run build --workspace=web

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM mirror.gcr.io/library/nginx:1.27-alpine AS runtime

# Copy built SPA (vite outputs to web/dist under the workspace root)
COPY --from=builder /app/web/dist /usr/share/nginx/html

# Mark this as a container install (plan 34 T3.1). The gateway's
# detect_install_kind() reads PERSONALCLAW_INSTALL_KIND and only the BACKEND
# container runs that Python process — but set it here too so every container in
# the deployment self-identifies consistently (e.g. `docker exec … env`).
ENV PERSONALCLAW_INSTALL_KIND=container

# Install our proxy-aware config as a TEMPLATE. The official nginx image's
# entrypoint (20-envsubst-on-templates.sh) renders /etc/nginx/templates/*.template
# into /etc/nginx/conf.d/ at container start, substituting ${NGINX_LOCAL_RESOLVERS}
# (auto-detected from the container's /etc/resolv.conf by 15-local-resolvers.envsh).
# This lets nginx re-resolve the gateway hostname at runtime so a recreated
# gateway container's new IP is picked up without a proxy restart.
# Remove the stock default.conf so only our rendered config is served.
COPY deploy/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
RUN rm -f /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf.bak

# openssl for the self-signed cert; cert-generation hook runs before envsubst.
RUN apk add --no-cache openssl
COPY deploy/docker/10-self-signed-cert.sh /docker-entrypoint.d/10-self-signed-cert.sh
RUN chmod +x /docker-entrypoint.d/10-self-signed-cert.sh

EXPOSE 80 443

# Health check hits the plain-HTTP /healthz so it never has to trust the
# self-signed cert.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:80/healthz > /dev/null || exit 1
