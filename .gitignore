# Editor / OS junk
*~
*#
*.swp
*.log
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
dist-client/

# Test / lint caches
.coverage
.coverage.*
.cache/
.pytest_cache/
.mypy_cache/
.hypothesis/
htmlcov/

# Virtualenvs (lives at the repo root: .venv/)
venv/
.venv/
.venv-client/

# IDE / editor configs
.vscode/
.idea/
*.sublime-*
*.iml
*.code-workspace
pyrightconfig.json

# Environment / secrets (.env.example stays tracked)
.env
.env.local

# Frontend
node_modules/
web/dist/
*.tsbuildinfo
# Workspace members must NOT carry their own lockfiles — the root package-lock.json
# is the single source of truth for the npm workspace (web, desktop). Stray member
# lockfiles trip npm's optional-dependency bug (npm/cli#4828) → broken native builds.
web/package-lock.json
desktop/package-lock.json
web/test-results/
web/playwright-report/

# Static assets generated from frontend build (tracked as a symlink is fine;
# a real directory here would be a stale copy — see docs on web build/serve)
src/personalclaw/static/dist

# Desktop app build artifacts (Electron + bundled PyInstaller backend)
desktop/dist/
desktop/out/
desktop/backend-dist/
*.dmg

# Local dev / runtime state
.personalclaw-dev*/
.mcp.json
runs.json
TASK_PROGRESS.md
dev-seed.sh
# Dev-session screenshots dropped at repo root (the app icon lives in desktop/)
/*.png

# Eval harness output
eval_results/

# Local tooling
.claude/
.playwright-mcp/
playwright-responses/

# Bare local dev gateway home (make serve creates $(CURDIR)/.dev-home).
# GLOB, not a fixed name: every dev home holds live credentials (.local_secret,
# session_key, sel_hmac.key), so an ad-hoc `.dev-home-<something>` for a one-off
# validation run must be ignored by default rather than each name being added
# after the fact. A `git add -A` in a repo root with an unignored dev home stages
# secrets — do not narrow this back to an exact match.
/.dev-home*/
# e2e harness dev home (playwright.config.ts recipe)
/.dev-home-e2e/
# Seeded marketing-screenshot home (the release runbook clones .dev-home into this).
# It holds a real signing key, live session records and credential material, so it must
# never be committable — the same reason .dev-home is ignored.
/.screenshot-home/

# Owner-provided local secrets — never committed. The real file lives at the
# workspace root (outside every repo); this rule is belt-and-braces.
.secrets.env
