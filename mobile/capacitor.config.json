{
  "appId": "dev.personalclaw.companion",
  "appName": "PersonalClaw",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "localhost",
      "127.0.0.1",
      "*.local",
      "10.*",
      "192.168.*",
      "172.16.*",
