    {"kind": "skill", "id": "infra-drift-audit", "path": "skills/infra-drift-audit/SKILL.md", "depends_on": []},
    {"kind": "agent", "id": "infra-reviewer", "path": "agents/infra-reviewer.md", "depends_on": ["skill:infra-plan-review", "skill:infra-drift-audit"]},
    {"kind": "template", "id": "infra-change-review", "path": "templates/infra-change-review.json", "depends_on": ["agent:infra-reviewer", "skill:infra-plan-review", "skill:infra-drift-audit"]}
  ],
  "requirements": [],
