{
  "schema_version": 1,
  "name": "infra-ops",
  "version": "1.0.0",
  "displayName": "Infra Ops",
  "description": "Review infrastructure-as-code changes honestly: plan counts before commentary, the destroy/replace list first, and a drift audit that names the attribute behind every divergence.",
  "author": "PersonalClaw",
